<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Birko.Xaml.Gallery.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Birko.Xaml.Avalonia/Controls/DataGridStyles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <!-- Birko design tokens + restyled ControlThemes, layered over Fluent. -->
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Birko.Xaml.Avalonia/BirkoTheme.axaml" />
        <!-- The gallery's own card (TASK-783). -->
        <ResourceInclude Source="avares://Birko.Xaml.Gallery/DemoCard.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
