<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev / validation artifact (STORY-031 go/no-go gate), not a shipped consumer. A runnable
       Avalonia desktop app that renders the first restyled controls across all four themes. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Birko.Xaml.Gallery</RootNamespace>
    <AssemblyName>Birko.Xaml.Gallery</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <!-- Consumer app: references the framework assemblies across the bucket boundary
       (Birko/Consumers -> Birko/Framework), mirroring how Birko.Web.Playground consumes Birko.Web. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Framework\Birko.Xaml.Core\Birko.Xaml.Core.csproj" />
    <ProjectReference Include="..\..\Framework\Birko.Xaml.Avalonia\Birko.Xaml.Avalonia.csproj" />
    <ProjectReference Include="..\..\Framework\Birko.Xaml.Shell\Birko.Xaml.Shell.csproj" />
  </ItemGroup>

</Project>
