<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Birko.Xaml.Avalonia.Controls;assembly=Birko.Xaml.Avalonia"
             x:Class="Birko.Xaml.Gallery.GalleryView"
             x:CompileBindings="False"
             FontFamily="{DynamicResource BFont}"
             Background="{DynamicResource BBgSecondaryBrush}">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">

      <TextBlock Text="Birko.Xaml — Tier 0 gallery"
                 FontSize="24" FontWeight="Bold"
                 Foreground="{DynamicResource BTextBrush}" />

      <TextBlock Text="Switch theme — every control below re-themes live:"
                 Foreground="{DynamicResource BTextSecondaryBrush}" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Light" Tag="light" Click="OnTheme" />
        <Button Content="Dark" Tag="dark" Click="OnTheme" />
        <Button Content="Neon" Tag="neon" Click="OnTheme" />
        <Button Content="Finstat" Tag="finstat" Click="OnTheme" />
      </StackPanel>

      <ContentControl Theme="{StaticResource BCard}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Card surface" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource BTextBrush}" VerticalAlignment="Center" />
            <ContentControl Theme="{StaticResource BBadge}" Content="NEW" FontSize="12" />
            <ContentControl Theme="{StaticResource BTag}" Content="draft" FontSize="12" />
          </StackPanel>

          <TextBlock TextWrapping="Wrap"
                     Foreground="{DynamicResource BTextSecondaryBrush}"
                     Text="Colors, corner radius and typography all come from design tokens shared with Birko.Web." />

          <TextBox Text="Editable input" Width="280" HorizontalAlignment="Left" />

          <ComboBox Width="280" HorizontalAlignment="Left" SelectedIndex="0">
            <ComboBoxItem Content="First option" />
            <ComboBoxItem Content="Second option" />
            <ComboBoxItem Content="Third option" />
          </ComboBox>

          <StackPanel Orientation="Horizontal" Spacing="20">
            <CheckBox Content="Checkbox" IsChecked="True" />
            <RadioButton Content="Option A" IsChecked="True" GroupName="g" />
            <RadioButton Content="Option B" GroupName="g" />
          </StackPanel>

          <ProgressBar Value="60" Maximum="100" />

          <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
            <ToggleSwitch Content="Notifications" IsChecked="True" />
            <c:BusySpinner />
            <Button Content="Actions ▾">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Edit" />
                  <MenuItem Header="Duplicate" />
                  <MenuItem Header="Delete" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <c:Breadcrumb x:Name="DemoCrumb" />

          <TabControl>
            <TabItem Header="Details">
              <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource BTextSecondaryBrush}"
                         Text="Tab content one." />
            </TabItem>
            <TabItem Header="History">
              <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource BTextSecondaryBrush}"
                         Text="Tab content two." />
            </TabItem>
          </TabControl>

          <Button Content="Primary action" HorizontalAlignment="Left"
                  ToolTip.Tip="A themed tooltip" />
        </StackPanel>
      </ContentControl>

      <TextBlock Text="Schema-driven form" FontWeight="SemiBold"
                 Foreground="{DynamicResource BTextBrush}" Margin="0,4,0,0" />
      <ContentControl Theme="{StaticResource BCard}">
        <c:Form x:Name="DemoForm" />
      </ContentControl>

      <TextBlock Text="Tree menu" FontWeight="SemiBold"
                 Foreground="{DynamicResource BTextBrush}" Margin="0,4,0,0" />
      <ContentControl Theme="{StaticResource BCard}">
        <TreeView>
          <TreeViewItem Header="Reports" IsExpanded="True">
            <TreeViewItem Header="Sales" />
            <TreeViewItem Header="Inventory" />
          </TreeViewItem>
          <TreeViewItem Header="Customers" IsExpanded="True">
            <TreeViewItem Header="Companies" />
            <TreeViewItem Header="Contacts" />
          </TreeViewItem>
          <TreeViewItem Header="Settings" />
        </TreeView>
      </ContentControl>

      <TextBlock Text="Data grid" FontWeight="SemiBold"
                 Foreground="{DynamicResource BTextBrush}" Margin="0,4,0,0" />
      <ContentControl Theme="{StaticResource BCard}" Padding="0">
        <DataGrid x:Name="DemoGrid" AutoGenerateColumns="False" Height="150"
                  IsReadOnly="True" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
            <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="Auto" />
          </DataGrid.Columns>
        </DataGrid>
      </ContentControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
