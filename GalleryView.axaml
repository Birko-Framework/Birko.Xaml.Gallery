<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Birko.Xaml.Avalonia.Controls;assembly=Birko.Xaml.Avalonia"
             xmlns:sv="clr-namespace:Birko.Xaml.Shell.Views;assembly=Birko.Xaml.Shell"
             x:Class="Birko.Xaml.Gallery.GalleryView"
             x:CompileBindings="False"
             FontFamily="{DynamicResource BFont}"
             Background="{DynamicResource BBgSecondaryBrush}">

  <Panel>
    <DockPanel Margin="20">

      <!-- Header: title + theme switcher -->
      <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
        <TextBlock Text="Birko.Xaml — control gallery" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource BTextBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Light" Tag="light" Click="OnTheme" />
          <Button Content="Dark" Tag="dark" Click="OnTheme" />
          <Button Content="Neon" Tag="neon" Click="OnTheme" />
          <Button Content="Finstat" Tag="finstat" Click="OnTheme" />
        </StackPanel>
      </StackPanel>

      <TabControl>

        <!-- ── Controls ─────────────────────────────────────────────── -->
        <TabItem Header="Controls">
          <ScrollViewer>
            <StackPanel Spacing="16" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Primary" />
                <Button Content="With tooltip" ToolTip.Tip="A themed tooltip" />
                <ContentControl Theme="{StaticResource BBadge}" Content="NEW" FontSize="12" />
                <ContentControl Theme="{StaticResource BTag}" Content="draft" FontSize="12" />
              </StackPanel>

              <TextBox Text="Editable input" Width="300" HorizontalAlignment="Left" />
              <ComboBox Width="300" HorizontalAlignment="Left" SelectedIndex="0">
                <ComboBoxItem Content="First option" />
                <ComboBoxItem Content="Second option" />
                <ComboBoxItem Content="Third option" />
              </ComboBox>

              <StackPanel Orientation="Horizontal" Spacing="20">
                <CheckBox Content="Checkbox" IsChecked="True" />
                <RadioButton Content="Option A" IsChecked="True" GroupName="g" />
                <RadioButton Content="Option B" GroupName="g" />
                <ToggleSwitch Content="Notifications" IsChecked="True" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <ProgressBar Value="60" Maximum="100" Width="200" />
                <c:BusySpinner />
                <Button Content="Actions ▾">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="Edit" />
                      <MenuItem Header="Duplicate" />
                      <MenuItem Header="Delete" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>

              <c:Breadcrumb x:Name="DemoCrumb" />
              <TextBlock x:Name="DemoCrumbStatus" FontSize="12" Opacity="0.7" />

              <!-- Slider (TASK-054): horizontal + a vertical equalizer bank -->
              <Slider Minimum="0" Maximum="100" Value="60" Width="240" HorizontalAlignment="Left" />
              <StackPanel Orientation="Horizontal" Spacing="16" Height="150">
                <Slider Orientation="Vertical" Minimum="0" Maximum="100" Value="30" />
                <Slider Orientation="Vertical" Minimum="0" Maximum="100" Value="55" />
                <Slider Orientation="Vertical" Minimum="0" Maximum="100" Value="80" />
                <Slider Orientation="Vertical" Minimum="0" Maximum="100" Value="45" />
                <Slider Orientation="Vertical" Minimum="0" Maximum="100" Value="65" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ── Forms & data ─────────────────────────────────────────── -->
        <TabItem Header="Forms &amp; data">
          <ScrollViewer>
            <StackPanel Spacing="16" Margin="0,12,0,0">
              <TextBlock Text="Schema-driven form" FontWeight="SemiBold" Foreground="{DynamicResource BTextBrush}" />
              <ContentControl Theme="{StaticResource BCard}"><c:Form x:Name="DemoForm" /></ContentControl>

              <TextBlock Text="Data grid" FontWeight="SemiBold" Foreground="{DynamicResource BTextBrush}" />
              <ContentControl Theme="{StaticResource BCard}" Padding="0">
                <DataGrid x:Name="DemoGrid" AutoGenerateColumns="False" Height="150" IsReadOnly="True" GridLinesVisibility="Horizontal">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                    <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="Auto" />
                  </DataGrid.Columns>
                </DataGrid>
              </ContentControl>

              <TextBlock Text="Tree menu" FontWeight="SemiBold" Foreground="{DynamicResource BTextBrush}" />
              <ContentControl Theme="{StaticResource BCard}">
                <TreeView>
                  <TreeViewItem Header="Reports" IsExpanded="True">
                    <TreeViewItem Header="Sales" />
                    <TreeViewItem Header="Inventory" />
                  </TreeViewItem>
                  <TreeViewItem Header="Customers" IsExpanded="True">
                    <TreeViewItem Header="Companies" />
                    <TreeViewItem Header="Contacts" />
                  </TreeViewItem>
                  <TreeViewItem Header="Settings" />
                </TreeView>
              </ContentControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ── Viewers ──────────────────────────────────────────────── -->
        <TabItem Header="Viewers">
          <ScrollViewer>
            <StackPanel Spacing="16" Margin="0,12,0,0">
              <TextBlock Text="JSON / object viewer" FontWeight="SemiBold" Foreground="{DynamicResource BTextBrush}" />
              <ContentControl Theme="{StaticResource BCard}"><c:ObjectTree x:Name="DemoJson" /></ContentControl>

              <TextBlock Text="XML viewer" FontWeight="SemiBold" Foreground="{DynamicResource BTextBrush}" />
              <ContentControl Theme="{StaticResource BCard}"><c:XmlViewer x:Name="DemoXml" /></ContentControl>

              <TextBlock Text="Markdown editor" FontWeight="SemiBold" Foreground="{DynamicResource BTextBrush}" />
              <ContentControl Theme="{StaticResource BCard}" Height="260"><c:MarkdownEditor x:Name="DemoMarkdown" /></ContentControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ── Composites ───────────────────────────────────────────── -->
        <TabItem Header="Composites">
          <ScrollViewer>
            <StackPanel Spacing="16" Margin="0,12,0,0">
              <TextBlock Text="Kanban" FontWeight="SemiBold" Foreground="{DynamicResource BTextBrush}" />
              <c:Kanban x:Name="DemoKanban" Height="220" />

              <TextBlock Text="Chart" FontWeight="SemiBold" Foreground="{DynamicResource BTextBrush}" />
              <ContentControl Theme="{StaticResource BCard}" Height="280"><c:BChart x:Name="DemoChart" /></ContentControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ── Chrome ───────────────────────────────────────────────── -->
        <TabItem Header="Chrome">
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="0,12,0,0">
              <TextBlock Text="Ribbon (BAppShell chrome)" FontWeight="SemiBold"
                         Foreground="{DynamicResource BTextBrush}" />
              <Border BorderThickness="1" BorderBrush="{DynamicResource BBorderBrush}"
                      CornerRadius="{DynamicResource BRadius}">
                <c:Ribbon x:Name="DemoRibbon" />
              </Border>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BTextSecondaryBrush}"
                         Text="The shell ships two chrome styles: a sidebar (ShellView) and this ribbon (RibbonShellView), both over the same ShellViewModel. Run a shell app to see them full-size; here is the ribbon control on its own." />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BTextSecondaryBrush}"
                         Text="Resize the window to watch Office-style progressive scaling: groups degrade Medium → Small → a single ▾ button (whose flyout holds the group at full size) in priority order, so Export gives way first and Clipboard last. Clipboard is floored at Small, so it gives way only if the alternative is clipping. Narrower still, the ▾ buttons drop their names (hover for the name); narrower again the whole ribbon becomes ☰. The tab strip scrolls; the ribbon body never does." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Pin mode:" VerticalAlignment="Center"
                           Foreground="{DynamicResource BTextSecondaryBrush}" />
                <Button Name="DemoRibbonPinToggle" Click="OnToggleRibbonPin" Content="Unpin the ribbon" />
                <TextBlock Name="DemoRibbonPinState" VerticalAlignment="Center"
                           Foreground="{DynamicResource BTextMutedBrush}"
                           Text="pinned — the body sits in the layout" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ── Overlays ─────────────────────────────────────────────── -->
        <TabItem Header="Overlays">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="Overlays open over the whole gallery." Foreground="{DynamicResource BTextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Open modal" Click="OnOpenModal" />
              <Button Content="New (form modal)" Click="OnOpenFormModal" />
              <Button Content="Open drawer" Click="OnOpenDrawer" />
              <Button Content="Command palette (Ctrl+K)" Click="OnOpenPalette" />
            </StackPanel>
          </StackPanel>
        </TabItem>

        <!-- ── Mobile shell ─────────────────────────────────────────── -->
        <TabItem Header="Mobile shell">
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="0,12,0,0">
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BTextSecondaryBrush}"
                         Text="BMobileAppShell equivalent — fixed top-bar + safe-area bottom-nav driven by the module nav-model (EPIC-016 / TASK-043). Tap a bottom-nav item to switch surfaces; the active item highlights." />
              <!-- Phone-sized frame so the mobile chrome reads as a device inside the desktop gallery. -->
              <Border Width="380" Height="640" HorizontalAlignment="Left"
                      CornerRadius="24" ClipToBounds="True" BorderThickness="8"
                      BorderBrush="{DynamicResource BBorderBrush}"
                      Background="{DynamicResource BBgSecondaryBrush}">
                <sv:MobileShellView x:Name="DemoMobileShell" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>
    </DockPanel>

    <!-- Root-level overlays -->
    <c:Modal x:Name="DemoModal" Title="A modal dialog">
      <TextBlock Text="Modals dim the backdrop and center a token-styled card. Click the backdrop to close."
                 TextWrapping="Wrap" Foreground="{DynamicResource BTextBrush}" />
    </c:Modal>

    <c:FormModal x:Name="DemoFormModal" Title="New contact" />

    <c:Drawer x:Name="DemoDrawer" Placement="Right">
      <StackPanel Spacing="12" Width="280">
        <TextBlock Text="Drawer" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource BTextBrush}" />
        <TextBlock Text="A slide-in panel anchored to the edge. Click the backdrop to dismiss."
                   TextWrapping="Wrap" Foreground="{DynamicResource BTextSecondaryBrush}" />
      </StackPanel>
    </c:Drawer>

    <c:CommandPalette x:Name="DemoPalette" />
  </Panel>
</UserControl>
